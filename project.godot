; Engine configuration file.
; Native OS shell and city blockout. Simulation and save schema are unchanged.

config_version=5

[application]

config/name="SIM-DURTY"
config/version="0.0.6"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://game/app/main.tscn"

[display]

window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="canvas_items"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.04, 0.05, 1)
