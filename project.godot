; Native available-size layout; the reference design is not a downscaled screenshot.
config_version=5

[application]
config/name="SIM-DURTY"
config/version="0.0.9"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/main_scene="res://game/app/main.tscn"

[display]
window/size/viewport_width=2560
window/size/viewport_height=1440
window/size/window_width_override=1600
window/size/window_height_override=900
window/stretch/mode="disabled"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.067, 0.086, 0.098, 1)
